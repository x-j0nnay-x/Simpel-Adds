                    "text": "1\tplugins {\n2\t    id 'java-library'\n3\t    id 'maven-publish'\n4\t    id 'net.neoforged.moddev' version '2.0.141'\n5\t    id 'idea'\n6\t}\n7\t\n8\ttasks.named('wrapper', Wrapper).configure {\n9\t    // Define wrapper values here so as to not have to always do so when updating gradlew.properties.\n10\t    // Switching this to Wrapper.DistributionType.ALL will download the full gradle sources that comes with\n11\t    // documentation attached on cursor hover of gradle classes and methods. However, this comes with increased\n12\t    // file size for Gradle. If you do switch this to ALL, run the Gradle wrapper task twice afterwards.\n13\t    // (Verify by checking gradle/wrapper/gradle-wrapper.properties to see if distributionUrl now points to `-all`)\n14\t    distributionType = Wrapper.DistributionType.BIN\n15\t}\n16\t\n17\tversion = mod_version\n18\tgroup = mod_group_id\n19\t\n20\tsourceSets.main.resources {\n21\t    // Include resources generated by data generators.\n22\t    srcDir('src/generated/resources')\n23\t\n24\t    // Exclude common development only resources from finalized outputs\n25\t    exclude(\"**/*.bbmodel\") // BlockBench project files\n26\t    exclude(\"src/generated/**/.cache\") // datagen cache files\n27\t}\n28\t\n29\trepositories {\n30\t    maven {\n31\t        // location of the maven that hosts JEI files since January 2023\n32\t        name = \"Jared's maven\"\n33\t        url = \"https://maven.blamejared.com/\"\n34\t    }\n35\t    maven {\n36\t        // location of a maven mirror for JEI files, as a fallback\n37\t        name = \"ModMaven\"\n38\t        url = \"https://modmaven.dev\"\n39\t    }\n40\t}\n41\t\n42\tbase {\n43\t    archivesName = mod_id\n44\t}\n45\t\n46\t// Mojang ships Java 25 to end users in 26.1.2, so mods should target Java 25.\n47\tjava.toolchain.languageVersion = JavaLanguageVersion.of(25)\n48\t\n49\tneoForge {\n50\t    // Specify the version of NeoForge to use.\n51\t    version = project.neo_version\n52\t\n53\t    // This line is optional. Access Transformers are automatically detected\n54\t    // accessTransformers = project.files('src/main/resources/META-INF/accesstransformer.cfg')\n55\t\n56\t    // Default run configurations.\n57\t    // These can be tweaked, removed, or duplicated as needed.\n58\t    runs {\n59\t        client {\n60\t            client()\n61\t\n62\t            // Comma-separated list of namespaces to load gametests from. Empty = all namespaces.\n63\t            systemProperty 'neoforge.enabledGameTestNamespaces', project.mod_id\n64\t        }\n65\t\n66\t        server {\n67\t            server()\n68\t            programArgument '--nogui'\n69\t            systemProperty 'neoforge.enabledGameTestNamespaces', project.mod_id\n70\t        }\n71\t\n72\t        // This run config launches GameTestServer and runs all registered gametests, then exits.\n73\t        // By default, the server will crash when no gametests are provided.\n74\t        // The gametest system is also enabled by default for other run configs under the /test command.\n75\t        gameTestServer {\n76\t            type = \"gameTestServer\"\n77\t            systemProperty 'neoforge.enabledGameTestNamespaces', project.mod_id\n78\t        }\n79\t\n80\t        data {\n81\t            clientData()\n82\t\n83\t            // example of overriding the workingDirectory set in configureEach above, uncomment if you want to use it\n84\t            // gameDirectory = project.file('run-data')\n85\t\n86\t            // Specify the modid for data generation, where to output the resulting resource, and where to look for existing resources.\n87\t            programArguments.addAll '--mod', project.mod_id, '--all', '--output', file('src/generated/resources/').getAbsolutePath(), '--existing', file('src/main/resources/').getAbsolutePath()\n88\t        }\n89\t\n90\t        // applies to all the run configs above\n91\t        configureEach {\n92\t            // Recommended logging data for a userdev environment\n93\t            // The markers can be added/remove as needed separated by commas.\n94\t            // \"SCAN\": For mods scan.\n95\t            // \"REGISTRIES\": For firing of registry events.\n96\t            // \"REGISTRYDUMP\": For getting the contents of all registries.\n97\t            systemProperty 'forge.logging.markers', 'REGISTRIES'\n98\t\n99\t            // Recommended logging level for the console\n100\t            // You can set various levels here.\n101\t            // Please read: https://stackoverflow.com/questions/2031163/when-to-use-the-different-log-levels\n102\t            logLevel = org.slf4j.event.Level.DEBUG\n103\t        }\n104\t    }\n105\t\n106\t    mods {\n107\t        // define mod <-> source bindings\n108\t        // these are used to tell the game which sources are for which mod\n109\t        // multi mod projects should define one per mod\n110\t        \"${mod_id}\" {\n111\t            sourceSet(sourceSets.main)\n112\t        }\n113\t    }\n114\t}\n115\t\n116\t// Sets up a dependency configuration called 'localRuntime'.\n117\t// This configuration should be used instead of 'runtimeOnly' to declare\n118\t// a dependency that will be present for runtime testing but that is\n119\t// \"optional\", meaning it will not be pulled by dependents of this mod.\n120\tconfigurations {\n121\t    runtimeClasspath.extendsFrom localRuntime\n122\t}\n123\t\n124\tdependencies {\n125\t    // Example optional mod dependency with JEI\n126\t    // The JEI API is declared for compile time use, while the full JEI artifact is used at runtime\n127\t     compileOnly \"mezz.jei:jei-${minecraft_version}-common-api:${jei_version}\"\n128\t     compileOnly \"mezz.jei:jei-${minecraft_version}-neoforge-api:${jei_version}\"\n129\t    // We add the full version to localRuntime, not runtimeOnly, so that we do not publish a dependency on it\n130\t    localRuntime \"mezz.jei:jei-${minecraft_version}-neoforge:${jei_version}\"\n131\t\n132\t    // Example mod dependency using a mod jar from ./libs with a flat dir repository\n133\t    // This maps to ./libs/coolmod-${mc_version}-${coolmod_version}.jar\n134\t    // The group id is ignored when searching -- in this case, it is \"blank\"\n135\t    // implementation \"blank:coolmod-${mc_version}:${coolmod_version}\"\n136\t\n137\t    // Example mod dependency using a file as dependency\n138\t    // implementation files(\"libs/coolmod-${mc_version}-${coolmod_version}.jar\")\n139\t\n140\t    // Example project dependency using a sister or child project:\n141\t    // implementation project(\":myproject\")\n142\t\n143\t    // For more info:\n144\t    // http://www.gradle.org/docs/current/userguide/artifact_dependencies_tutorial.html\n145\t    // http://www.gradle.org/docs/current/userguide/dependency_management.html\n146\t}\n147\t\n148\t// This block of code expands all declared replace properties in the specified resource targets.\n149\t// A missing property will result in an error. Properties are expanded using ${} Groovy notation.\n150\tvar generateModMetadata = tasks.register(\"generateModMetadata\", ProcessResources) {\n151\t    var replaceProperties = [\n152\t            minecraft_version      : minecraft_version,\n153\t            minecraft_version_range: minecraft_version_range,\n154\t            neo_version            : neo_version,\n155\t            mod_id                 : mod_id,\n156\t            mod_name               : mod_name,\n157\t            mod_license            : mod_license,\n158\t            mod_version            : mod_version,\n159\t            jei_version            : jei_version,\n160\t    ]\n161\t    inputs.properties replaceProperties\n162\t    expand replaceProperties\n163\t    from \"src/main/templates\"\n164\t    into \"build/generated/sources/modMetadata\"\n165\t}\n166\t// Include the output of \"generateModMetadata\" as an input directory for the build\n167\t// this works with both building through Gradle and the IDE.\n168\tsourceSets.main.resources.srcDir generateModMetadata\n169\t// To avoid having to run \"generateModMetadata\" manually, make it run on every project reload\n170\tneoForge.ideSyncTask generateModMetadata\n171\t\n172\t// Example configuration to allow publishing using the maven-publish plugin\n173\tpublishing {\n174\t    publications {\n175\t        register('mavenJava', MavenPublication) {\n176\t            from components.java\n177\t        }\n178\t    }\n179\t    repositories {\n180\t        maven {\n181\t            url \"file://${project.projectDir}/repo\"\n182\t        }\n183\t    }\n184\t}\n185\t\n186\ttasks.withType(JavaCompile).configureEach {\n187\t    options.encoding = 'UTF-8' // Use the UTF-8 charset for Java compilation\n188\t}\n189\t\n190\t// IDEA no longer automatically downloads sources/javadoc jars for dependencies, so we need to explicitly enable the behavior.\n191\tidea {\n192\t    module {\n193\t        downloadSources = true\n194\t        downloadJavadoc = true\n195\t    }\n196\t}\n197"
