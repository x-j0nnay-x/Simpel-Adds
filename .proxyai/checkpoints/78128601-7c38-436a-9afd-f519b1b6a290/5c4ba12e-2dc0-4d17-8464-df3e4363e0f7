                "new_string": "public class Travel_Cristal extends Item {\n    public Travel_Cristal(Properties properties) {\n        super(properties);\n    }\n\n    @Override\n    public InteractionResult useOn(UseOnContext context) {\n        Player player = context.getPlayer();\n        if (player == null) {\n            return InteractionResult.PASS;\n        }\n\n        Level level = context.getLevel();\n        ItemStack itemStack = context.getItemInHand();\n\n        if (player.isCrouching()) {\n            if (level.isClientSide()) {\n                return InteractionResult.SUCCESS;\n            }\n\n            if (hasStoredHome(itemStack)) {\n                clearStoredHome(itemStack);\n                player.sendSystemMessage(Component.translatable(\"tooltip.simpeladdmod.travel_crystal.home_reset\"));\n            } else {\n                setStoredHome(itemStack, context.getClickedPos(), level.dimension());\n                player.sendSystemMessage(Component.translatable(\"tooltip.simpeladdmod.travel_crystal.home_set\"));\n            }\n            return InteractionResult.SUCCESS;\n        }\n\n        return teleportToStoredHome(player, itemStack, context.getHand());\n    }\n\n    @Override\n    public InteractionResult use(Level level, Player player, InteractionHand hand) {\n        if (player.isCrouching()) {\n            return InteractionResult.PASS;\n        }\n\n        ItemStack itemStack = player.getItemInHand(hand);\n        return teleportToStoredHome(player, itemStack, hand);\n    }\n\n    private InteractionResult teleportToStoredHome(Player player, ItemStack itemStack, InteractionHand hand) {\n        if (!(player instanceof net.minecraft.server.level.ServerPlayer serverPlayer)) {\n            return InteractionResult.SUCCESS;\n        }\n\n        BlockPos storedPos = itemStack.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n        net.minecraft.resources.ResourceKey<Level> storedDimension = itemStack.get(Mod_Registrys.Mod_Data_Componet.DIMENSION.get());\n        if (storedPos == null || storedDimension == null) {\n            player.sendSystemMessage(Component.translatable(\"tooltip.simpeladdmod.travel_crystal.home_missing\"));\n            return InteractionResult.FAIL;\n        }\n\n        net.minecraft.server.level.ServerLevel targetLevel = serverPlayer.getServer().getLevel(storedDimension);\n        if (targetLevel == null) {\n            player.sendSystemMessage(Component.translatable(\"tooltip.simpeladdmod.travel_crystal.dimension_missing\"));\n            return InteractionResult.FAIL;\n        }\n\n        serverPlayer.teleportTo(\n                targetLevel,\n                storedPos.getX() + 0.5D,\n                storedPos.getY() + 1.0D,\n                storedPos.getZ() + 0.5D,\n                serverPlayer.getYRot(),\n                serverPlayer.getXRot());\n\n        itemStack.hurtAndBreak(1, serverPlayer, LivingEntity.getSlotForHand(hand));\n        return InteractionResult.SUCCESS;\n    }\n\n    private static boolean hasStoredHome(ItemStack itemStack) {\n        return itemStack.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get()) != null\n                && itemStack.get(Mod_Registrys.Mod_Data_Componet.DIMENSION.get()) != null;\n    }\n\n    private static void setStoredHome(ItemStack itemStack, BlockPos blockPos, net.minecraft.resources.ResourceKey<Level> dimension) {\n        itemStack.set(Mod_Registrys.Mod_Data_Componet.COORDINATES.get(), blockPos.immutable());\n        itemStack.set(Mod_Registrys.Mod_Data_Componet.DIMENSION.get(), dimension);\n    }\n\n    private static void clearStoredHome(ItemStack itemStack) {\n        itemStack.remove(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n        itemStack.remove(Mod_Registrys.Mod_Data_Componet.DIMENSION.get());\n    }\n\n    @Override\n    public InteractionResult interactLivingEntity(ItemStack itemStack, Player player, LivingEntity livingEntity, InteractionHand hand) {\n        Level level = player.level();\n        if (livingEntity instanceof Player || livingEntity.isDeadOrDying()) {\n            return InteractionResult.PASS;\n        }\n\n        Optional<Item> vanillaSpawnEgg = SpawnEggItem.byId(livingEntity.getType()).map(Holder::value);\n\n        if (level.isClientSide()) {\n            return InteractionResult.SUCCESS;\n        }\n\n        ItemStack spawnEggStack = createSimpelSpawnerEgg(livingEntity, vanillaSpawnEgg);\n        if (spawnEggStack.isEmpty()) {\n            return InteractionResult.PASS;\n        }\n\n        if (livingEntity instanceof Container container) {\n            for (int slot = 0; slot < container.getContainerSize(); slot++) {\n                ItemStack stackInSlot = container.getItem(slot);\n                if (!stackInSlot.isEmpty()) {\n                    Containers.dropItemStack(level, livingEntity.getX(), livingEntity.getY(), livingEntity.getZ(), stackInSlot.copy());\n                    container.setItem(slot, ItemStack.EMPTY);\n                }\n            }\n        }\n\n        if (livingEntity.isVehicle()) {\n            livingEntity.ejectPassengers();\n        }\n        if (livingEntity.isPassenger()) {\n            livingEntity.stopRiding();\n        }\n        if (player.getVehicle() == livingEntity) {\n            player.stopRiding();\n        }\n\n        livingEntity.discard();\n        itemStack.shrink(1);\n        player.drop(spawnEggStack, false);\n        return InteractionResult.SUCCESS;\n    }\n\n    private ItemStack createSimpelSpawnerEgg(LivingEntity livingEntity, Optional<Item> vanillaSpawnEgg) {\n        ItemStack simpelSpawnerEgg = new ItemStack(Mod_Registrys.Mod_Items.SIMPEL_SPAWNER_EGG.get());\n\n        String entityId = EntityType.getKey(livingEntity.getType()).toString();\n        simpelSpawnerEgg.set(Mod_Registrys.Mod_Data_Componet.SIMPEL_SPAWNER_ENTITY.get(), entityId);\n\n        String fallbackEntityId = vanillaSpawnEgg\n                .filter(item -> item != net.minecraft.world.level.block.Blocks.AIR.asItem())\n                .map(item -> {\n                    ItemStack stack = new ItemStack(item);\n                    EntityType<?> spawnType = SpawnEggItem.getType(stack);\n                    return spawnType != null ? EntityType.getKey(spawnType).toString() : \"\";\n                })\n                .orElseGet(() -> {\n                    if (livingEntity instanceof Horse) {\n                        EntityType<?> horseType = SpawnEggItem.getType(new ItemStack(Items.HORSE_SPAWN_EGG));\n                        return horseType != null ? EntityType.getKey(horseType).toString() : \"\";\n                    }\n                    return \"\";\n                });\n\n        if (fallbackEntityId.isEmpty()) {\n            return ItemStack.EMPTY;\n        }\n\n        simpelSpawnerEgg.set(Mod_Registrys.Mod_Data_Componet.SIMPEL_SPAWNER_FALLBACK_ENTITY.get(), fallbackEntityId);\n        return simpelSpawnerEgg;\n    }\n\n    @Override\n    public void appendHoverText(ItemStack itemStack, TooltipContext context, TooltipDisplay display, Consumer<Component> builder, TooltipFlag tooltipFlag) {\n        builder.accept(Component.translatable(\"tooltip.simpeladdmod.travel_crystal\"));\n\n        BlockPos storedPos = itemStack.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n        net.minecraft.resources.ResourceKey<Level> storedDimension = itemStack.get(Mod_Registrys.Mod_Data_Componet.DIMENSION.get());\n\n        if (storedPos == null || storedDimension == null) {\n            builder.accept(Component.translatable(\"tooltip.simpeladdmod.travel_crystal.home_missing\"));\n            return;\n        }\n\n        builder.accept(Component.translatable(\"tooltip.simpeladdmod.travel_crystal.dimension\", storedDimension.location().toString()));\n        builder.accept(Component.translatable(\"tooltip.simpeladdmod.travel_crystal.coordinates\", storedPos.getX(), storedPos.getY(), storedPos.getZ()));\n    }\n}\n",
