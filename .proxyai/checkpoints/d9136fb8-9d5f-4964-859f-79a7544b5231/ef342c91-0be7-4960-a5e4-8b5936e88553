mport x_j0nnay_x.simpeladdmod.init.Mod_Block_Entitys;\n37\timport x_j0nnay_x.simpeladdmod.init.Mod_Items;\n38\timport x_j0nnay_x.simpeladdmod.init.Mod_Recipes;\n39\timport x_j0nnay_x.simpeladdmod.init.Mod_Tags;\n40\timport x_j0nnay_x.simpeladdmod.items.Grinder_Head_Item;\n41\timport x_j0nnay_x.simpeladdmod.menu.Grinder_Menu;\n42\timport x_j0nnay_x.simpeladdmod.recipe.Grinder_Recipe;\n43\timport x_j0nnay_x.simpeladdmod.init.Constants;\n44\t\n45\timport java.util.Optional;\n46\t\n47\t\n48\tpublic class Grinder_Block_Entity extends BlockEntity implements MenuProvider {\n49\t\n50\t    public final ItemStacksResourceHandler inventory = new ItemStacksResourceHandler(5) {\n51\t        @Override\n52\t        protected void onContentsChanged(int index, ItemStack previousContents) {\n53\t            super.onContentsChanged(index, previousContents);\n54\t            Grinder_Block_Entity.this.setChanged();\n55\t        }\n56\t    };\n57\t\n58\t    private final ResourceHandler<ItemResource> sideHandler = RangedResourceHandler.of(inventory, GRINDING_SLOT, GRINDING_SLOT + 1);\n59\t    private final ResourceHandler<ItemResource> topHandler = RangedResourceHandler.of(inventory, INPUT_SLOT, INPUT_SLOT + 1);\n60\t    private final ResourceHandler<ItemResource> bottomHandler = RangedResourceHandler.of(inventory, OUTPUT_SLOT, OUTPUT_SLOT + 1);\n61\t\n62\t    public static int INPUT_SLOT = 0;\n63\t    public static int GRINDING_SLOT = 1;\n64\t    public static int OUTPUT_SLOT = 2;\n65\t    public static int UPGRADING_SLOT = 3;\n66\t    public static int BOOSTING_SLOT = 4;\n67\t    private static final int[] SLOTS_UP = new int[]{INPUT_SLOT};\n68\t    private static final int[] SLOTS_DOWN = new int[]{OUTPUT_SLOT};\n69\t    private static final int[] SLOTS_SIDES = new int[]{GRINDING_SLOT};\n70\t    protected final ContainerData data;\n71\t    private int progress = 0;\n72\t    private int max_Progress;\n73\t    private int grinds_Left = 0;\n74\t    private int max_Grinds = 3;\n75\t    private int grind_Efficiency = 5;\n76\t    private int has_Booster = 0;\n77\t\n78\t    public Grinder_Block_Entity(BlockPos worldPosition, BlockState blockState) {\n79\t        super(Mod_Block_Entitys.GRINDER_BLOCK_ENTITY.get(), worldPosition, blockState);\n80\t        this.data = new ContainerData() {\n81\t            @Override\n82\t            public int get(int dataId) {\n83\t                return switch (dataId) {\n84\t                    case 0 -> Grinder_Block_Entity.this.progress;\n85\t                    case 1 -> Grinder_Block_Entity.this.max_Progress;\n86\t                    case 2 -> Grinder_Block_Entity.this.grinds_Left;\n87\t                    case 3 -> Grinder_Block_Entity.this.max_Grinds;\n88\t                    case 4 -> Grinder_Block_Entity.this.grind_Efficiency;\n89\t                    case 5 -> Grinder_Block_Entity.this.has_Booster;\n90\t                    default -> 0;\n91\t                };\n92\t            }\n93\t\n94\t            @Override\n95\t            public void set(int dataId, int value) {\n96\t                switch (dataId) {\n97\t                    case 0 -> Grinder_Block_Entity.this.progress = dataId;\n98\t                    case 1 -> Grinder_Block_Entity.this.max_Progress = dataId;\n99\t                    case 2 -> Grinder_Block_Entity.this.grinds_Left = dataId;\n100\t                    case 3 -> Grinder_Block_Entity.this.max_Grinds = dataId;\n101\t                    case 4 -> Grinder_Block_Entity.this.grind_Efficiency = dataId;\n102\t                    case 5 -> Grinder_Block_Entity.this.has_Booster = dataId;\n103\t                }\n104\t            }\n105\t\n106\t            @Override\n107\t            public int getCount() {\n108\t                return 6;\n109\t            }\n110\t        };\n111\t    }\n112\t\n113\t    @Override\n114\t    public Component getDisplayName() {\n115\t        return Component.translatable(\"block.simpeladdmod.grinder\");\n116\t    }\n117\t\n118\t    @Override\n119\t    public @Nullable AbstractContainerMenu createMenu(int containerId, Inventory inventory, Player player) {\n120\t        return new Grinder_Menu(containerId, inventory, this, this.inventory, this.data);\n121\t    }\n122\t\n123\t    @Override\n124\t    protected void saveAdditional(ValueOutput output) {\n125\t        super.saveAdditional(output);\n126\t        output.putInt(Constants.MOD_CUSTOM +\"grinder_progress\", this.progress);\n127\t        output.putInt(Constants.MOD_CUSTOM +\"grinder_grinds_left\", this.grinds_Left);\n128\t        output.putInt(Constants.MOD_CUSTOM + \"grinder_efficiency\", this.grind_Efficiency);\n129\t        output.putChild(\"inventory\", inventory);\n130\t    }\n131\t\n132\t    @Override\n133\t    protected void loadAdditional(ValueInput input) {\n134\t        super.loadAdditional(input);\n135\t        progress = input.getIntOr(Constants.MOD_CUSTOM +\"grinder_progress\", 0);\n136\t        grinds_Left = input.getIntOr(Constants.MOD_CUSTOM +\"grinder_grinds_left\", 0);\n137\t        grind_Efficiency = input.getIntOr(Constants.MOD_CUSTOM + \"grinder_efficiency\", 5);\n138\t        input.child(\"inventory\").ifPresent(inventory::deserialize);\n139\t    }\n140\t\n141\t    public void drops() {\n142\t        SimpleContainer inv = new SimpleContainer(inventory.size());\n143\t        for (int i = 0; i < inventory.size(); i++) {\n144\t            ItemAccess itemAccess = ItemAccess.forHandlerIndex(inventory, 0);\n145\t            inv.setItem(i, new ItemStack(itemAccess.getResource().getItem(), itemAccess.getAmount()));\n146\t        }\n147\t        Containers.dropContents(this.level, this.worldPosition, inv);\n148\t    }\n149\t\n150\t    public ResourceHandler<ItemResource> getItemHandler(Direction direction) {\n151\t        if (direction == null)\n152\t            return inventory;\n153\t\n154\t        Direction facing = this.getBlockState().hasProperty(BlockStateProperties.HORIZONTAL_FACING)\n155\t                ? this.getBlockState().getValue(BlockStateProperties.HORIZONTAL_FACING)\n156\t                : Direction.NORTH;\n157\t\n158\t        return switch (getRelativeSide(facing, direction)) {\n159\t            case UP -> topHandler;\n160\t            case DOWN -> bottomHandler;\n161\t            case WEST -> sideHandler;\n162\t            case EAST -> sideHandler;\n163\t            case NORTH, SOUTH -> sideHandler;\n164\t        };\n165\t    }\n166\t\n167\t    private Direction getRelativeSide(Direction facing, Direction absoluteSide) {\n168\t        if (absoluteSide.getAxis().isVertical()) return absoluteSide;\n169\t\n170\t        if (absoluteSide == facing) return Direction.NORTH;\n171\t        if (absoluteSide == facing.getOpposite()) return Direction.SOUTH;\n172\t        if (absoluteSide == facing.getClockWise()) return Direction.WEST;\n173\t        if (absoluteSide == facing.getCounterClockWise()) return Direction.EAST;\n174\t\n175\t        return absoluteSide;\n176\t    }\n177\t\n178\t    public void tick(Level level, BlockPos pos, BlockState state) {\n179\t        setUpGrades();\n180\t        if(hasRecipe() && isOutputSlotEmptyOrReceivable()) {\n181\t            if(this.grinds_Left > 0){\n182\t                increaseCraftingProgress();\n183\t                setChanged(level, pos, state);\n184\t                level.setBlockAndUpdate(pos, state.setValue(BlockStateProperties.LIT, true));\n185\t                if(hasCraftingFinished()){\n186\t                    useGrind();\n187\t                    craftItem();\n188\t                    resetProgress();\n189\t                }\n190\t            }else{\n191\t                resetGrinds();\n192\t            }\n193\t        }else {\n194\t            resetProgress();\n195\t            level.setBlockAndUpdate(pos, state.setValue(BlockStateProperties.LIT, false));\n196\t        }\n197\t    }\n198\t    public boolean hasRecipeForItem(ItemStack stack) {\n199\t        return ((ServerLevel) level).recipeAccess()\n200\t                .getRecipeFor(Mod_Recipes.GRINDER_RECIPE_TYPES.get(),\n201\t                        new SingleRecipeInput(stack), level)\n202\t                .isPresent();\n203\t    }\n204\t\n205\t    private boolean hasRecipe() {\n206\t        Optional<RecipeHolder<Grinder_Recipe>> recipe = getCurrentRecipe();\n207\t        if(recipe.isEmpty()) {\n208\t            return false;\n209\t        }\n210\t\n211\t        ItemStack output = recipe.get().value().assemble(new SingleRecipeInput(inventory.getResource(INPUT_SLOT).toStack()));\n212\t\n213\t        boolean outputSlotAmount = canInsertAmountIntoOutputSlot(output.getCount());\n214\t        boolean outputSlotItem = canInsertItemIntoOutputSlot(output);\n215\t\n216\t        return outputSlotItem && outputSlotAmount;\n217\t    }\n218\t\n219\t    private Optional<RecipeHolder<Grinder_Recipe>> getCurrentRecipe() {\n220\t        return ((ServerLevel) level).recipeAccess()\n221\t                .getRecipeFor(Mod_Recipes.GRINDER_RECIPE_TYPES.get(),\n222\t                        new SingleRecipeInput(inventory.getResource(INPUT_SLOT).toStack()), level);\n223\t    }\n224\t\n225\t    private boolean canInsertItemIntoOutputSlot(ItemStack output) {\n226\t        return inventory.getResource(OUTPUT_SLOT).isEmpty() ||\n227\t                inventory.getResource(OUTPUT_SLOT).is(output.getItem());\n228\t    }\n229\t\n230\t    private boolean canInsertAmountIntoOutputSlot(int count) {\n231\t        int maxCount = inventory.getResource(OUTPUT_SLOT).isEmpty() ? 64 : inventory.getResource(OUTPUT_SLOT).getMaxStackSize();\n232\t        int currentCount = inventory.getAmountAsInt(OUTPUT_SLOT);\n233\t\n234\t        return maxCount >= currentCount + count;\n235\t    }\n236\t\n237\t    private void craftItem() {\n238\t        Optional<RecipeHolder<Grinder_Recipe>> recipe = getCurrentRecipe();\n239\t        ItemStack output = recipe.get().value().getOutput().create();\n240\t        try(Transaction transaction = Transaction.openRoot()) {\n241\t            ItemAccess itemAccess = ItemAccess.forHandlerIndex(inventory, OUTPUT_SLOT);\n242\t            inventory.extract(inventory.getResource(INPUT_SLOT), 1, transaction);\n243\t            inventory.set(OUTPUT_SLOT, ItemResource.of(output), itemAccess.getAmount() + output.getCount());\n244\t            transaction.commit();\n245\t        }\n246\t    }\n247\t\n248\t    private boolean isOutputSlotEmptyOrReceivable() {\n249\t        return inventory.getResource(OUTPUT_SLOT).isEmpty() ||\n250\t                inventory.getResource(OUTPUT_SLOT).test(stack -> stack.count() < stack.getMaxStackSize());\n251\t    }\n252\t\n253\t    private void increaseCraftingProgress() {\n254\t        this.progress++;\n255\t    }\n256\t\n257\t    private boolean hasCraftingFinished() {\n258\t        return this.progress >= this.max_Progress;\n259\t    }\n260\t\n261\t    private void resetProgress() {\n262\t        this.progress = 0;\n263\t    }\n264\t\n265\t    private void setUpGrades(){\n266\t        if(inventory.getResource(this.UPGRADING_SLOT).is(Mod_Items.SPEED_UPGRADE_1.get())) {\n267\t            this.max_Progress = 40;\n268\t        }\n269\t        if(inventory.getResource(this.UPGRADING_SLOT).is(Mod_Items.SPEED_UPGRADE_2.get())) {\n270\t            this.max_Progress = 24;\n271\t        }\n272\t        if(inventory.getResource(this.UPGRADING_SLOT).is(Mod_Items.SPEED_UPGRADE_3.get())) {\n273\t            this.max_Progress = 10;\n274\t        }\n275\t        if(inventory.getResource(this.UPGRADING_SLOT).is(Mod_Items.SPEED_UPGRADE_4.get())) {\n276\t            this.max_Progress = 5;\n277\t        }\n278\t        if(inventory.getResource(this.UPGRADING_SLOT).isEmpty()){\n279\t            this.max_Progress = 60;\n280\t        }\n281\t        if(this.inventory.getResource(this.BOOSTING_SLOT).is(Mod_Items.BOOST_UPGRADE.get())){\n282\t            this.has_Booster = 1;\n283\t        }\n284\t        if(inventory.getResource(this.BOOSTING_SLOT).isEmpty()){\n285\t            this.has_Booster = 0;\n286\t        }\n287\t    }\n288\t\n289\t    private void resetGrindEfficiency(){\n290\t        this.grind_Efficiency = 5;\n291\t    }\n292\t\n293\t    private void useGrind(){\n294\t        if(this.inventory.getResource(this.BOOSTING_SLOT).is(Mod_Items.BOOST_UPGRADE.get())){\n295\t            if(this.grind_Efficiency > 0){\n296\t                this.grind_Efficiency--;\n297\t            }else {\n298\t                this.grinds_Left--;\n299\t                resetGrindEfficiency();\n300\t            }\n301\t        }else {\n302\t            this.grinds_Left--;\n303\t        }\n304\t    }\n305\t\n306\t    private void resetGrinds() {\n307\t        if(this.inventory.getResource(this.GRINDING_SLOT).is(Mod_Tags.Items.GRINDERS)) {\n308\t            this.inventory.set(GRINDING_SLOT, ItemResource.of(Grinder_Head_Item.brakeItem(this.inventory.getResource(GRINDING_SLOT).toStack())), 1);\n309\t            grinds_Left = max_Grinds;\n310\t        }else {\n311\t            this.grinds_Left = 0;\n312\t        }\n313\t    }\n314\t\n315\t    /* BLOCK ENTITY SYNC STUFF */\n316\t    @Override\n317\t    public @Nullable Packet<ClientGamePacketListener> getUpdatePacket() {\n318\t        return ClientboundBlockEntityDataPacket.create(this);\n319\t    }\n320"
