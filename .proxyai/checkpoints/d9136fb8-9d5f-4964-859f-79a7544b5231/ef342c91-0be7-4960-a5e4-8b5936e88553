   return blockEntity.hasRecipeForItem(itemStack);\n40\t            }\n41\t        });\n42\t        this.addSlot(new ResourceHandlerSlot(handler, handler::set,Grinder_Block_Entity.GRINDING_SLOT, 79,  17){\n43\t            @Override\n44\t            public boolean mayPlace(ItemStack stack) {\n45\t                return stack.is(Mod_Tags.Items.GRINDERS);\n46\t            }\n47\t        });\n48\t        this.addSlot(new ResourceHandlerSlot(handler, handler::set,Grinder_Block_Entity.OUTPUT_SLOT, 124, 44) {\n49\t            @Override\n50\t            public boolean mayPlace(ItemStack itemStack) {\n51\t                return false;\n52\t            }\n53\t        });\n54\t        this.addSlot(new ResourceHandlerSlot(handler, handler::set,Grinder_Block_Entity.UPGRADING_SLOT, 144, 12) {\n55\t            @Override\n56\t            public boolean mayPlace(ItemStack stack) {\n57\t                return stack.is(Mod_Tags.Items.UPGRADES);\n58\t            }\n59\t            @Override\n60\t            public int getMaxStackSize() {\n61\t                return 1;\n62\t            }\n63\t        });\n64\t        this.addSlot(new ResourceHandlerSlot(handler, handler::set,Grinder_Block_Entity.BOOSTING_SLOT, 124, 13){\n65\t            @Override\n66\t            public boolean mayPlace(ItemStack stack) {\n67\t                return stack.is(Mod_Items.BOOST_UPGRADE.get());\n68\t            }\n69\t             @Override\n70\t            public int getMaxStackSize() {\n71\t                return 1;\n72\t            }\n73\t        });\n74\t\n75\t        addDataSlots(data);\n76\t    }\n77\t\n78\t    public boolean isCrafting() {\n79\t        return data.get(0) > 0;\n80\t    }\n81\t\n82\t    public int getScaledArrowProgress() {\n83\t        int progress = this.data.get(0);\n84\t        int maxProgress = this.data.get(1);\n85\t        int arrowPixelSize = 57;\n86\t\n87\t        return maxProgress != 0 && progress != 0 ? progress * arrowPixelSize / maxProgress : 0;\n88\t    }\n89\t\n90\t    // CREDIT GOES TO: diesieben07 | https://github.com/diesieben07/SevenCommons\n91\t    // must assign a slot number to each of the slots used by the GUI.\n92\t    // For this container, we can see both the tile inventory's slots as well as the player inventory slots and the hotbar.\n93\t    // Each time we add a Slot to the container, it automatically increases the slotIndex, which means\n94\t    //  0 - 8 = hotbar slots (which will map to the InventoryPlayer slot numbers 0 - 8)\n95\t    //  9 - 35 = player inventory slots (which map to the InventoryPlayer slot numbers 9 - 35)\n96\t    //  36 - 44 = TileInventory slots, which map to our TileEntity slot numbers 0 - 8)\n97\t    private static final int HOTBAR_SLOT_COUNT = 9;\n98\t    private static final int PLAYER_INVENTORY_ROW_COUNT = 3;\n99\t    private static final int PLAYER_INVENTORY_COLUMN_COUNT = 9;\n100\t    private static final int PLAYER_INVENTORY_SLOT_COUNT = PLAYER_INVENTORY_COLUMN_COUNT * PLAYER_INVENTORY_ROW_COUNT;\n101\t    private static final int VANILLA_SLOT_COUNT = HOTBAR_SLOT_COUNT + PLAYER_INVENTORY_SLOT_COUNT;\n102\t    private static final int VANILLA_FIRST_SLOT_INDEX = 0;\n103\t    private static final int TE_INVENTORY_FIRST_SLOT_INDEX = VANILLA_FIRST_SLOT_INDEX + VANILLA_SLOT_COUNT;\n104\t\n105\t    // THIS YOU HAVE TO DEFINE!\n106\t    private static final int TE_INVENTORY_SLOT_COUNT = 5;  // must be the number of slots you have!\n107\t    @Override\n108\t    public ItemStack quickMoveStack(Player playerIn, int pIndex) {\n109\t        Slot sourceSlot = slots.get(pIndex);\n110\t        if (sourceSlot == null || !sourceSlot.hasItem()) return ItemStack.EMPTY;  //EMPTY_ITEM\n111\t        ItemStack sourceStack = sourceSlot.getItem();\n112\t        ItemStack copyOfSourceStack = sourceStack.copy();\n113\t\n114\t        // Check if the slot clicked is one of the vanilla container slots\n115\t        if (pIndex < VANILLA_FIRST_SLOT_INDEX + VANILLA_SLOT_COUNT) {\n116\t            // This is a vanilla container slot so merge the stack into the tile inventory\n117\t            if (!moveItemStackTo(sourceStack, TE_INVENTORY_FIRST_SLOT_INDEX, TE_INVENTORY_FIRST_SLOT_INDEX\n118\t                    + TE_INVENTORY_SLOT_COUNT, false)) {\n119\t                return ItemStack.EMPTY;  // EMPTY_ITEM\n120\t            }\n121\t        } else if (pIndex < TE_INVENTORY_FIRST_SLOT_INDEX + TE_INVENTORY_SLOT_COUNT) {\n122\t            // This is a TE slot so merge the stack into the players inventory\n123\t            if (!moveItemStackTo(sourceStack, VANILLA_FIRST_SLOT_INDEX, VANILLA_FIRST_SLOT_INDEX + VANILLA_SLOT_COUNT, false)) {\n124\t                return ItemStack.EMPTY;\n125\t            }\n126\t        } else {\n127\t            System.out.println(\"Invalid slotIndex:\" + pIndex);\n128\t            return ItemStack.EMPTY;\n129\t        }\n130\t        // If stack size == 0 (the entire stack was moved) set slot contents to null\n131\t        if (sourceStack.getCount() == 0) {\n132\t            sourceSlot.set(ItemStack.EMPTY);\n133\t        } else {\n134\t            sourceSlot.setChanged();\n135\t        }\n136\t        sourceSlot.onTake(playerIn, sourceStack);\n137\t        return copyOfSourceStack;\n138\t    }\n139\t\n140\t    @Override\n141\t    public boolean stillValid(Player pPlayer) {\n142\t        return stillValid(ContainerLevelAccess.create(level, blockEntity.getBlockPos()),\n143\t                pPlayer, Mod_Blocks.GRINDER_BLOCK.get());\n144\t    }\n145\t\n146\t    private void addPlayerInventory(Inventory playerInventory) {\n147\t        for (int i = 0; i < 3; ++i) {\n148\t            for (int l = 0; l < 9; ++l) {\n149\t                this.addSlot(new Slot(playerInventory, l + i * 9 + 9, 8 + l * 18, 84 + i * 18));\n150\t            }\n151\t        }\n152\t    }\n153\t\n154\t    private void addPlayerHotbar(Inventory playerInventory) {\n155\t        for (int i = 0; i < 9; ++i) {\n156\t            this.addSlot(new Slot(playerInventory, i, 8 + i * 18, 142));\n157\t        }\n158\t    }\n159\t}"
