                    "text": "{\"file_path\":\"C:/Users/FoulC/OneDrive/Desktop/MineCraft Modding/SimpelAdd Dev Env/simpeladdmod-neoforge-26.1.2/src/main/java/x_j0nnay_x/simpeladdmod/events/Player_Interaction_Events.java\",\"content\":\"package x_j0nnay_x.simpeladdmod.events;\\n\\nimport net.minecraft.world.InteractionResult;\\nimport net.minecraft.world.entity.LivingEntity;\\nimport net.minecraft.world.entity.animal.equine.Horse;\\nimport net.minecraft.world.entity.player.Player;\\nimport net.minecraft.world.item.ItemStack;\\nimport net.neoforged.bus.api.SubscribeEvent;\\nimport net.neoforged.neoforge.event.entity.player.PlayerInteractEvent;\\nimport x_j0nnay_x.simpeladdmod.init.Mod_Registrys;\\n\\npublic final class Player_Interaction_Events {\\n\\n    private Player_Interaction_Events() {\\n    }\\n\\n    @SubscribeEvent\\n    public static void onEntityInteractSpecific(PlayerInteractEvent.EntityInteractSpecific event) {\\n        handleHorseTravelCrystalUse(event, event.getTarget());\\n    }\\n\\n    @SubscribeEvent\\n    public static void onEntityInteract(PlayerInteractEvent.EntityInteract event) {\\n        handleHorseTravelCrystalUse(event, event.getTarget());\\n    }\\n\\n    private static void handleHorseTravelCrystalUse(PlayerInteractEvent event, net.minecraft.world.entity.Entity target) {\\n        if (!(target instanceof Horse horse)) {\\n            return;\\n        }\\n\\n        Player player = event.getEntity();\\n        ItemStack heldStack = event.getItemStack();\\n        if (!heldStack.is(Mod_Registrys.Mod_Items.TRAVEL_CRYSTAL.get())) {\\n            return;\\n        }\\n\\n        InteractionResult result = heldStack.getItem().interactLivingEntity(heldStack, player, horse, event.getHand());\\n        if (result.consumesAction()) {\\n            event.setCanceled(true);\\n            if (event instanceof PlayerInteractEvent.EntityInteractSpecific specificEvent) {\\n                specificEvent.setCancellationResult(result);\\n            } else if (event instanceof PlayerInteractEvent.EntityInteract entityInteractEvent) {\\n                entityInteractEvent.setCancellationResult(result);\\n            }\\n        }\\n    }\\n}\\n\"}"
