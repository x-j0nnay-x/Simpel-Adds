\n129\t        for (int i = 0; i < inventory.size(); i++) {\n130\t            ItemAccess itemAccess = ItemAccess.forHandlerIndex(inventory, i);\n131\t            int amount = itemAccess.getAmount();\n132\t            ItemStack stack = itemAccess.getResource().toStack();\n133\t            inv.setItem(i, amount > 0 ? stack.copyWithCount(amount) : ItemStack.EMPTY);\n134\t        }\n135\t        Containers.dropContents(this.level, this.worldPosition, inv);\n136\t    }\n137\t\n138\t\n139\t\n140\t    public ResourceHandler<ItemResource> getItemHandler(Direction direction) {\n141\t        if (direction == null)\n142\t            return inventory;\n143\t\n144\t        Direction facing = this.getBlockState().hasProperty(BlockStateProperties.HORIZONTAL_FACING)\n145\t                ? this.getBlockState().getValue(BlockStateProperties.HORIZONTAL_FACING)\n146\t                : Direction.NORTH;\n147\t\n148\t        return switch (getRelativeSide(facing, direction)) {\n149\t            case UP, WEST, EAST,NORTH, SOUTH, DOWN -> allHandler;\n150\t        };\n151\t    }\n152\t\n153\t    private Direction getRelativeSide(Direction facing, Direction absoluteSide) {\n154\t        if (absoluteSide.getAxis().isVertical()) return absoluteSide;\n155\t        if (absoluteSide == facing) return Direction.NORTH;\n156\t        if (absoluteSide == facing.getOpposite()) return Direction.SOUTH;\n157\t        if (absoluteSide == facing.getClockWise()) return Direction.WEST;\n158\t        if (absoluteSide == facing.getCounterClockWise()) return Direction.EAST;\n159\t        return absoluteSide;\n160\t    }\n161\t\n162\t    public void tick(ServerLevel level, BlockPos pos, BlockState state) {\n163\t        setUpGrades();\n164\t        if(isGrowStaffusable()) {\n165\t            startFarmLandLoop( level);\n166\t        }\n167\t        if(level.getBlockState(pos).getValue(Harvester_Block.POWERED))\n168\t            return;\n169\t        if(this.tickCount >= this.tickSpeed) {\n170\t            startHarvestLoop(level);\n171\t        }else{\n172\t            this.tickCount++;\n173\t        }\n174\t    }\n175\t\n176\t    private void setUpGrades(){\n177\t        if (this.inventory.getResource(SPEEDSLOT).is(Mod_Registrys.Mod_Items.SPEED_UPGRADE_1.get())) {\n178\t            this.tickSpeed = 80;\n179\t        }if (this.inventory.getResource(SPEEDSLOT).is(Mod_Registrys.Mod_Items.SPEED_UPGRADE_2.get())) {\n180\t            this.tickSpeed = 60;\n181\t        }if (this.inventory.getResource(SPEEDSLOT).is(Mod_Registrys.Mod_Items.SPEED_UPGRADE_3.get())) {\n182\t            this.tickSpeed = 40;\n183\t        }if (this.inventory.getResource(SPEEDSLOT).is(Mod_Registrys.Mod_Items.SPEED_UPGRADE_4.get())) {\n184\t            this.tickSpeed = 20;\n185\t        }if (this.inventory.getResource(SPEEDSLOT).isEmpty()){\n186\t            this.tickSpeed = 100;\n187\t        }if (this.inventory.getResource(EFFICIENCYSLOT).isEmpty()){\n188\t            this.tickEfficiency = 0;\n189\t        }if (!this.inventory.getResource(EFFICIENCYSLOT).isEmpty()){\n190\t            this.tickEfficiency = 1;\n191\t        }\n192\t    }\n193\t\n194\t    public int getCountBoost(){\n195\t        return this.inventory.getAmountAsInt(this.EFFICIENCYSLOT);\n196\t    }\n197\t\n198\t    //chest above code\n199\t    public boolean isChestabove() {\n200\t        return getContainerAbove(this.getBlockPos(), this.level) != null;\n201\t    }\n202\t\n203\t    public boolean hasRemoteUpgrade() {\n204\t        return this.inventory.getResource(REMOTESLOT).is(Mod_Registrys.Mod_Items.REMOTE_UPGRADE.get());\n205\t    }\n206\t\n207\t    @Nullable\n208\t    private Container getRemoteContainer() {\n209\t        if (this.level == null || !hasRemoteUpgrade()) {\n210\t            return null;\n211\t        }\n212\t\n213\t        ItemStack remoteUpgrade = this.inventory.getResource(REMOTESLOT).toStack();\n214\t        BlockPos remotePos = remoteUpgrade.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n215\t        if (remotePos == null) {\n216\t            return null;\n217\t        }\n218\t\n219\t        BlockState state = this.level.getBlockState(remotePos);\n220\t        Container container = getBlockContainer(this.level, remotePos, state);\n221\t        return container != null\n222\t                ? container\n223\t                : getEntityContainer(this.level, remotePos.getX(), remotePos.getY(), remotePos.getZ());\n224\t    }\n225\t\n226\t    @Nullable\n227\t    public static Container getContainerAbove(BlockPos blockPos, Level level) {\n228\t        BlockPos containerPos = blockPos.above();\n229\t        BlockState state = level.getBlockState(containerPos);\n230\t        Container container = getBlockContainer(level, containerPos, state);\n231\t        return container != null ? container : getEntityContainer(level, containerPos.getX(), containerPos.getY(), containerPos.getZ());\n232\t    }\n233\t\n234\t    @Nullable\n235\t    private static Container getEntityContainer(Level level, double x, double y, double z) {\n236\t        List<Entity> list = level.getEntities((Entity)null, new AABB(x - (double)0.5F, y - (double)0.5F, z - (double)0.5F, x + (double)0.5F, y + (double)0.5F, z + (double)0.5F), EntitySelector.CONTAINER_ENTITY_SELECTOR);\n237\t        return !list.isEmpty() ? (Container)list.get(level.getRandom().nextInt(list.size())) : null;\n238\t    }\n239\t\n240\t   @Nullable\n241\t    private static Container getBlockContainer(Level level, BlockPos pos, BlockState state) {\n242\t        Block block = state.getBlock();\n243\t        if (block instanceof WorldlyContainerHolder worldlyContainerHolder) {\n244\t            return worldlyContainerHolder.getContainer(state, level, pos);\n245\t        }\n246\t\n247\t        if (!state.hasBlockEntity()) {\n248\t            return null;\n249\t        }\n250\t\n251\t        BlockEntity blockEntity = level.getBlockEntity(pos);\n252\t        if (!(blockEntity instanceof Container container)) {\n253\t            return null;\n254\t        }\n255\t\n256\t        if (container instanceof ChestBlockEntity && block instanceof ChestBlock chestBlock) {\n257\t            return ChestBlock.getContainer(chestBlock, state, level, pos, true);\n258\t        }\n259\t\n260\t        return container;\n261\t    }\n262\t\n263\t    //Item Handleing\n264\t    public static void justDrop(ServerLevel pLevel, List<ItemStack> drops, BlockPos cropPos) {\n265\t        for (ItemStack drop : drops) {\n266\t            ItemEntity itemEntity = new ItemEntity(pLevel, cropPos.getX(), cropPos.getY(), cropPos.getZ(), drop);\n267\t            pLevel.addFreshEntity(itemEntity);\n268\t        }\n269\t    }\n270\t\n271\t    private List<ItemStack> putDropsInChest(List<ItemStack> drops, Container container) {\n272\t        if (container == null) {\n273\t            return drops;\n274\t        }\n275\t        List<ItemStack> remainingDrops = new ArrayList<>();\n276\t        for (ItemStack drop : drops) {\n277\t            ItemStack remaining = HopperBlockEntity.addItem(null, container, drop.copy(), Direction.DOWN);\n278\t            if (!remaining.isEmpty()) {\n279\t                remainingDrops.add(remaining);\n280\t                break;\n281\t            }\n282\t        }\n283\t        return remainingDrops;\n284\t    }\n285\t\n286\t    //Harvesting code\n287\t    private void startHarvestLoop(ServerLevel world) {\n288\t        BlockPos blockPos = this.getBlockPos();\n289\t        int range = this.getCountBoost() + 1 ;\n290\t        int cropRange = 2;\n291\t        for (BlockPos blockPos1 : BlockPos.betweenClosed(blockPos.offset(-range, -cropRange,  -range), blockPos.offset(range, cropRange, range))) {\n292\t            havestBlocks(world, blockPos1);\n293\t        }\n294\t        this.tickCount = 0;\n295\t    }\n296\t\n297\t    public void havestBlocks(ServerLevel serverLevel, BlockPos blockPos) {\n298\t//        if (!isHavestableBlock(serverLevel.getBlockState(blockPos)))\n299\t//            return;\n300\t        BlockState 