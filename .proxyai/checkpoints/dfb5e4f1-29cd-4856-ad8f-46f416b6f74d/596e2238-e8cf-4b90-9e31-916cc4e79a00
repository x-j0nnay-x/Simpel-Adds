                    "text": "1\tpackage x_j0nnay_x.simpeladdmod.items;\n2\t\n3\timport net.minecraft.core.BlockPos;\n4\timport net.minecraft.core.component.DataComponents;\n5\timport net.minecraft.core.registries.Registries;\n6\timport net.minecraft.nbt.CompoundTag;\n7\timport net.minecraft.network.chat.Component;\n8\timport net.minecraft.resources.ResourceKey;\n9\timport net.minecraft.server.level.ServerLevel;\n10\timport net.minecraft.sounds.SoundEvents;\n11\timport net.minecraft.world.InteractionHand;\n12\timport net.minecraft.world.InteractionResult;\n13\timport net.minecraft.world.entity.Entity;\n14\timport net.minecraft.world.entity.EquipmentSlot;\n15\timport net.minecraft.world.entity.Relative;\n16\timport net.minecraft.world.entity.player.Player;\n17\timport net.minecraft.world.item.Item;\n18\timport net.minecraft.world.item.ItemStack;\n19\timport net.minecraft.world.item.TooltipFlag;\n20\timport net.minecraft.world.item.component.CustomData;\n21\timport net.minecraft.world.item.component.TooltipDisplay;\n22\timport net.minecraft.world.item.context.UseOnContext;\n23\timport net.minecraft.world.level.Level;\n24\timport net.minecraft.world.level.block.Blocks;\n25\timport net.minecraft.world.level.block.state.BlockState;\n26\timport org.jspecify.annotations.Nullable;\n27\timport x_j0nnay_x.simpeladdmod.init.Mod_Registrys;\n28\timport x_j0nnay_x.simpeladdmod.init.Mod_Tags;\n29\t\n30\timport java.util.Set;\n31\timport java.util.function.Consumer;\n32\t\n33\tpublic class Home_Wand extends Item {\n34\t    private int cooldown;\n35\t    private boolean oncooldown;\n36\t    private int maxcooldown = 240;\n37\t\n38\t    public Home_Wand(Properties properties) {\n39\t        super(properties.stacksTo(1));\n40\t    }\n41\t\n42\t    @Override\n43\t    public void inventoryTick(ItemStack itemStack, ServerLevel level, Entity owner, @Nullable EquipmentSlot slot) {\n44\t        super.inventoryTick(itemStack, level, owner, slot);\n45\t        if(this.oncooldown) {\n46\t            this.cooldown ++;\n47\t            if(this.cooldown >= this.maxcooldown) {\n48\t                this.oncooldown = false;\n49\t                this.cooldown = 0;\n50\t            }\n51\t        }\n52\t    }\n53\t\n54\t    public boolean isUseable(ItemStack itemstack) {\n55\t        return itemstack.getDamageValue() < itemstack.getMaxDamage();\n56\t    }\n57\t\n58\t    @Override\n59\t    public InteractionResult use(Level level, Player player, InteractionHand hand) {\n60\t        ItemStack itemStack = player.getItemInHand(hand);\n61\t        if (!level.isClientSide()) {\n62\t            if (player.isCrouching()) {\n63\t                if (!hasData(itemStack)) {\n64\t                    setData(player, level);\n65\t                    player.sendOverlayMessage(Component.translatable(\"player_message.simpeladdmod.homewand.homeset\"));\n66\t                    return InteractionResult.SUCCESS;\n67\t                } else {\n68\t                    removeData(player);\n69\t                    player.sendOverlayMessage(Component.translatable(\"player_message.simpeladdmod.homewand.homeclear\"));\n70\t                    return InteractionResult.SUCCESS;\n71\t                }\n72\t            }\n73\t            if (!this.oncooldown && !player.isCrouching()) {\n74\t                if (isUseable(itemStack)) {\n75\t                    if (hasData(itemStack)) {\n76\t                        ResourceKey<Level> savedDimension = itemStack.get(Mod_Registrys.Mod_Data_Componet.DIMENSION.get());\n77\t                        if (savedDimension != null && savedDimension.equals(level.dimension())) {\n78\t                            itemStack.setDamageValue(itemStack.getDamageValue() + 1);\n79\t                            tellaport(player, itemStack);\n80\t                            return InteractionResult.SUCCESS;\n81\t                        } else {\n82\t                            itemStack.setDamageValue(itemStack.getDamageValue() + 1);\n83\t                            changeDim(player, itemStack);\n84\t                            return InteractionResult.SUCCESS;\n85\t\n86\t                        }\n87\t                    }\n88\t\n89\t                } else {\n90\t                    player.sendOverlayMessage(Component.translatable(\"tooltip.simpeladdmod.broken_item\"));\n91\t                }\n92\t            }\n93\t        }\n94\t        if (this.oncooldown) {\n95\t            player.sendOverlayMessage(Component.translatable(\"player_message.simpeladdmod.homewand.cooldown\"));\n96\t        }\n97\t        if (!isUseable(itemStack)) {\n98\t            player.sendOverlayMessage(Component.translatable(\"tooltip.simpeladdmod.broken_item\"));\n99\t        }\n100\t\n101\t        return super.use(level, player, hand);\n102\t    }\n103\t\n104\t    private boolean hasData(ItemStack stack){\n105\t        if(stack.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get()) != null && stack.get(Mod_Registrys.Mod_Data_Componet.DIMENSION.get()) != null){\n106\t            return true;\n107\t        }\n108\t        return false;\n109\t    }\n110\t\n111\t    private void setData(Player player, Level level){\n112\t        ItemStack itemStack = player.getItemInHand(InteractionHand.MAIN_HAND);\n113\t        BlockPos blockPos = new BlockPos(player.getBlockX(), player.getBlockY(), player.getBlockZ());\n114\t        itemStack.set(Mod_Registrys.Mod_Data_Componet.COORDINATES.get(), blockPos);\n115\t        itemStack.set(Mod_Registrys.Mod_Data_Componet.DIMENSION.get() ,level.dimension());\n116\t\n117\t    }\n118\t    private void removeData(Player player){\n119\t        ItemStack itemStack = player.getItemInHand(InteractionHand.MAIN_HAND);\n120\t        itemStack.remove(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n121\t        itemStack.remove(Mod_Registrys.Mod_Data_Componet.DIMENSION.get());\n122\t    }\n123\t    private void tellaport(Player player, ItemStack itemStack) {\n124\t        BlockPos blockPos = itemStack.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n125\t        if (blockPos == null) {\n126\t            player.sendOverlayMessage(Component.translatable(\"player_message.simpeladdmod.homewand.homeless\"));\n127\t            return;\n128\t        }\n129\t\n130\t        player.playSound(SoundEvents.ENDERMAN_TELEPORT, 1.0F, 1.0F);\n131\t        this.oncooldown = true;\n132\t        double centXpos = blockPos.getCenter().x();\n133\t        double centzpos = blockPos.getCenter().z();\n134\t        double yPos = blockPos.getY() + .02;\n135\t        player.teleportTo(centXpos, yPos, centzpos);\n136\t    }\n137\t\n138\t    private void changeDim(Player player, ItemStack itemStack) {\n139\t        Level level = player.level();\n140\t        BlockPos blockPos = itemStack.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n141\t        ResourceKey<Level> targetDimension = itemStack.get(Mod_Registrys.Mod_Data_Componet.DIMENSION.get());\n142\t        if (blockPos == null || targetDimension == null || level.getServer() == null) {\n143\t            player.sendOverlayMessage(Component.translatable(\"player_message.simpeladdmod.homewand.homeless\"));\n144\t            return;\n145\t        }\n146\t\n147\t        ServerLevel serverLevel = level.getServer().getLevel(targetDimension);\n148\t        if (serverLevel == null) {\n149\t            player.sendOverlayMessage(Component.translatable(\"player_message.simpeladdmod.homewand.homeless\"));\n150\t            return;\n151\t        }\n152\t\n153\t        this.oncooldown = true;\n154\t        double centXpos = blockPos.getCenter().x();\n155\t        double centzpos = blockPos.getCenter().z();\n156\t        double yPos = blockPos.getY() + .02;\n157\t        player.teleportTo(serverLevel, centXpos, yPos, centzpos, Relative.ALL, 0.0f, 0.0f, true);\n158\t    }\n159\t    @Override\n160\t    public void appendHoverText(ItemStack itemStack, TooltipContext context, TooltipDisplay display, Consumer<Component> builder, TooltipFlag tooltipFlag) {\n161\t        if(!isUseable(itemStack)) {\n162\t            builder.accept(Component.translatable(\"tooltip.simpeladdmod.broken_item\"));\n163\t        }\n164\t\n165\t        BlockPos location = itemStack.get(Mod_Registrys.Mod_Data_Componet.COORDINATES.get());\n166\t        if (location != null) {\n167\t            builder.accept(Component.translatable(\"tooltip.simpeladdmod.homewand.location\", location.getX(), location.getY(), location.getZ()));\n168\t        }\n169\t\n170\t        ResourceKey<Level> dimension = itemStack.get(Mod_Registrys.Mod_Data_Componet.DIMENSION.get());\n171\t        if (dimension != null) {\n172\t            builder.accept(Component.translatable(\"tooltip.simpeladdmod.homewand.dimension\", Mod_Registrys.Mod_Data_Componet.DIMENSION.get().toString()));\n173\t        }\n174\t\n175\t        super.appendHoverText(itemStack, context, display, builder, tooltipFlag);\n176\t    }\n177\t}\n178"
