ackTo(sourceStack, TE_INVENTORY_FIRST_SLOT_INDEX, TE_INVENTORY_FIRST_SLOT_INDEX\n160\t                    + TE_INVENTORY_SLOT_COUNT, false)) {\n161\t                return ItemStack.EMPTY;  // EMPTY_ITEM\n162\t            }\n163\t        } else if (pIndex < TE_INVENTORY_FIRST_SLOT_INDEX + TE_INVENTORY_SLOT_COUNT) {\n164\t            // This is a TE slot so merge the stack into the players inventory\n165\t            if (!moveItemStackTo(sourceStack, VANILLA_FIRST_SLOT_INDEX, VANILLA_FIRST_SLOT_INDEX + VANILLA_SLOT_COUNT, false)) {\n166\t                return ItemStack.EMPTY;\n167\t            }\n168\t        } else {\n169\t            System.out.println(\"Invalid slotIndex:\" + pIndex);\n170\t            return ItemStack.EMPTY;\n171\t        }\n172\t        // If stack size == 0 (the entire stack was moved) set slot contents to null\n173\t        if (sourceStack.getCount() == 0) {\n174\t            sourceSlot.set(ItemStack.EMPTY);\n175\t        } else {\n176\t            sourceSlot.setChanged();\n177\t        }\n178\t        sourceSlot.onTake(playerIn, sourceStack);\n179\t        return copyOfSourceStack;\n180\t    }\n181\t\n182\t    @Override\n183\t    public boolean stillValid(Player pPlayer) {\n184\t        return stillValid(ContainerLevelAccess.create(level, blockEntity.getBlockPos()),\n185\t                pPlayer, Mod_Registrys.Mod_Blocks.SIMPEL_SPAWNER.get());\n186\t    }\n187\t\n188\t    private void addPlayerInventory(Inventory playerInventory) {\n189\t        for (int i = 0; i < 3; ++i) {\n190\t            for (int l = 0; l < 9; ++l) {\n191\t                this.addSlot(new Slot(playerInventory, l + i * 9 + 9, 8 + l * 18, 84 + i * 18));\n192\t            }\n193\t        }\n194\t    }\n195\t\n196\t    private void addPlayerHotbar(Inventory playerInventory) {\n197\t        for (int i = 0; i < 9; ++i) {\n198\t            this.addSlot(new Slot(playerInventory, i, 8 + i * 18, 142));\n199\t        }\n200\t    }\n201\t}"
